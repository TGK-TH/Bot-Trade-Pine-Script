//@version=6
indicator("TGK CDC Lookalike Account 2", overlay=true)

//==================================================
// INPUT
//==================================================

emaFastLen = input.int(12, "EMA Fast")
emaSlowLen = input.int(26, "EMA Slow")

showDebug = input.bool(true)

retracementMin = input.float(61.8, "Retracement Min %")
retracementMax = input.float(100.0, "Retracement Max %")

//==================================================
// EMA
//==================================================

ema12 = ta.ema(close, emaFastLen)
ema26 = ta.ema(close, emaSlowLen)

plot(ema12, color=color.green)
plot(ema26, color=color.orange)

//==================================================
// CROSS
//==================================================

greenCross = ta.crossover(ema12, ema26)
redCross   = ta.crossunder(ema12, ema26)

plotshape(greenCross,
     style=shape.circle,
     color=color.lime,
     size=size.small,
     location=location.belowbar)

plotshape(redCross,
     style=shape.circle,
     color=color.red,
     size=size.small,
     location=location.abovebar)

//==================================================
// CURRENT SEGMENT
//==================================================

var int segStart = na

var float currentHigh = na
var float currentLow  = na

var int currentHighBar = na
var int currentLowBar  = na

var bool currentIsGreen = ema12 > ema26

//==================================================
// HISTORY
//==================================================
type Segment
    int startBar
    int endBar

    int crossBar

    float highest
    int highestBar

    float lowest
    int lowestBar

    bool isGreen

var segments = array.new<Segment>()

//==================================================
// SEGMENT FUNCTIONS
//==================================================

HasEnoughSegments(int count) =>
    array.size(segments) >= count

GetSegment(int offset) =>
    array.get(segments, array.size(segments) - 1 - offset)

//==================================================
// Pattern Checking Functions
//==================================================
IsBuyPattern() =>
    if not HasEnoughSegments(3)
        false
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        // Pattern must be:
        // S2 = Red
        // S1 = Green
        // S0 = Red
        bool correctSequence = not s2.isGreen and s1.isGreen and not s0.isGreen

        if not correctSequence
            false
        else
            // S2 = Red Far
            // S1 = Green
            // S0 = Red Near

            float low1  = s2.lowest
            float high1 = s1.highest
            float low2  = s0.lowest

            // Higher Low
            bool higherLow = low2 > low1

            // Prevent invalid range between high1 and low1
            float L1H1Range = high1 - low1

            if not higherLow or L1H1Range <= 0
                false
            else
                float retracement = (high1 - low2) / L1H1Range * 100.0

                retracement >= retracementMin and retracement <= retracementMax

IsSellPattern() =>
    if not HasEnoughSegments(3)
        false
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        s2.isGreen and not s1.isGreen and s0.isGreen

//==================================================
// Get Retracement for Debugging
//==================================================
GetBuyRetracement() =>
    if not HasEnoughSegments(3)
        na
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        float low1  = s2.lowest
        float high1 = s1.highest
        float low2  = s0.lowest

        float L1H1Range = high1 - low1

        if L1H1Range <= 0
            na
        else
            (high1 - low2) / L1H1Range * 100.0

//==================================================
// INITIALIZE
//==================================================

if barstate.isfirst
    segStart := bar_index
    currentHigh := high
    currentLow := low
    currentHighBar := bar_index
    currentLowBar := bar_index
    currentIsGreen := ema12 > ema26

//==================================================
// UPDATE CURRENT SEGMENT
//==================================================

if high > currentHigh
    currentHigh := high
    currentHighBar := bar_index

if low < currentLow
    currentLow := low
    currentLowBar := bar_index

//==================================================
// SAVE SEGMENT
//==================================================

crossHappened = greenCross or redCross

if crossHappened
    seg = Segment.new(
        segStart,
        bar_index - 1,
        bar_index,
        currentHigh,
        currentHighBar,
        currentLow,
        currentLowBar,
        currentIsGreen
    )
    array.push(segments, seg)

    //--------------------------------------
    // Start next segment
    //--------------------------------------

    segStart := bar_index

    currentHigh := high
    currentHighBar := bar_index

    currentLow := low
    currentLowBar := bar_index

    currentIsGreen := greenCross

//==================================================
// DEBUG
//==================================================
if showDebug and crossHappened and HasEnoughSegments(3)

    Segment s0 = GetSegment(0)
    Segment s1 = GetSegment(1)
    Segment s2 = GetSegment(2)

    bool buyPattern = IsBuyPattern()

    float low1 = s2.lowest
    float high1 = s1.highest
    float low2 = s0.lowest

    float buyRetracement = GetBuyRetracement()

    string msg =
          "BUY Pattern Check"
      + "\nL1 : " + str.tostring(low1)
      + "\nH1 : " + str.tostring(high1)
      + "\nL2 : " + str.tostring(low2)
      + "\nRetracement : "
      + str.tostring(buyRetracement, "#.##") + "%"
      + "\nHigher Low : "
      + str.tostring(low2 > low1)
      + "\nResult : "
      + (buyPattern ? "PASS" : "FAIL")

    label.new(
        bar_index,
        s0.isGreen ? s0.highest : s0.lowest,
        msg,
        style= s0.isGreen ? label.style_label_down : label.style_label_up,
        color=buyPattern ? color.green : color.gray,
        textcolor=color.white
    )
