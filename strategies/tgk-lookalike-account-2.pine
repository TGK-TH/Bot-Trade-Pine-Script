//@version=6
strategy(
    "TGK CDC Lookalike Account 2",
    overlay=true,
    pyramiding=0,
    process_orders_on_close=true
)

//==================================================
// INPUT
//==================================================

emaFastLen = input.int(12, "EMA Fast")
emaSlowLen = input.int(26, "EMA Slow")

showDebug = input.bool(true)

retracementMin = input.float(61.8, "Retracement Min %")
retracementMax = input.float(100.0, "Retracement Max %")

fixedLot = input.float(10.0, "Fixed Lot", minval=0.01, step=0.01)

//==================================================
// EMA
//==================================================

ema12 = ta.ema(close, emaFastLen)
ema26 = ta.ema(close, emaSlowLen)

plot(ema12, color=color.green)
plot(ema26, color=color.orange)

//==================================================
// CROSS
//==================================================

greenCross = ta.crossover(ema12, ema26)
redCross   = ta.crossunder(ema12, ema26)

plotshape(greenCross,
     style=shape.circle,
     color=color.lime,
     size=size.small,
     location=location.belowbar)

plotshape(redCross,
     style=shape.circle,
     color=color.red,
     size=size.small,
     location=location.abovebar)

//==================================================
// CURRENT SEGMENT
//==================================================

var int segStart = na

var float currentHigh = na
var float currentLow  = na

var int currentHighBar = na
var int currentLowBar  = na

var bool currentIsGreen = ema12 > ema26

//==================================================
// HISTORY
//==================================================
type Segment
    int startBar
    int endBar

    int crossBar

    float highest
    int highestBar

    float lowest
    int lowestBar

    bool isGreen

var segments = array.new<Segment>()

//==================================================
// SEGMENT FUNCTIONS
//==================================================

HasEnoughSegments(int count) =>
    array.size(segments) >= count

GetSegment(int offset) =>
    array.get(segments, array.size(segments) - 1 - offset)

//==================================================
// Check Buy Pattern Functions
//==================================================
IsBuyPattern() =>
    if not HasEnoughSegments(3)
        false
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        // Pattern must be:
        // S2 = Red
        // S1 = Green
        // S0 = Red
        bool correctSequence = not s2.isGreen and s1.isGreen and not s0.isGreen

        if not correctSequence
            false
        else
            // S2 = Red Far
            // S1 = Green
            // S0 = Red Near

            float low1  = s2.lowest
            float high1 = s1.highest
            float low2  = s0.lowest

            // Higher Low
            bool higherLow = low2 > low1

            // Prevent invalid range between high1 and low1
            float L1H1Range = high1 - low1

            if not higherLow or L1H1Range <= 0
                false
            else
                float retracement = (high1 - low2) / L1H1Range * 100.0

                retracement >= retracementMin and retracement <= retracementMax

//==================================================
// Check Sell Pattern Functions
//==================================================
IsSellPattern() =>
    if not HasEnoughSegments(3)
        false
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        // Pattern must be:
        // S2 = Green
        // S1 = Red
        // S0 = Green

        bool correctSequence = s2.isGreen and not s1.isGreen and s0.isGreen

        if not correctSequence
            false
        else
            // S2 = Green Far
            // S1 = Red
            // S0 = Green Near

            float high1 = s2.highest
            float low1  = s1.lowest
            float high2 = s0.highest

            // Lower High
            bool lowerHigh = high2 < high1

            // Prevent invalid range
            float H1L1Range = high1 - low1

            if not lowerHigh or H1L1Range <= 0
                false
            else
                float retracement = (high2 - low1) / H1L1Range * 100.0

                retracement >= retracementMin and retracement <= retracementMax

//==================================================
// Get Buy Retracement for Debugging
//==================================================
GetBuyRetracement() =>
    if not HasEnoughSegments(3)
        na
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        float low1  = s2.lowest
        float high1 = s1.highest
        float low2  = s0.lowest

        float L1H1Range = high1 - low1

        if L1H1Range <= 0
            na
        else
            (high1 - low2) / L1H1Range * 100.0

//==================================================
// Get Sell Retracement for Debugging
//==================================================

GetSellRetracement() =>
    if not HasEnoughSegments(3)
        na
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        float high1 = s2.highest
        float low1  = s1.lowest
        float high2 = s0.highest

        float H1L1Range = high1 - low1

        if H1L1Range <= 0
            na
        else
            (high2 - low1) / H1L1Range * 100.0

//==================================================
// INITIALIZE
//==================================================

if barstate.isfirst
    segStart := bar_index
    currentHigh := high
    currentLow := low
    currentHighBar := bar_index
    currentLowBar := bar_index
    currentIsGreen := ema12 > ema26

//==================================================
// UPDATE CURRENT SEGMENT
//==================================================

if high > currentHigh
    currentHigh := high
    currentHighBar := bar_index

if low < currentLow
    currentLow := low
    currentLowBar := bar_index

//==================================================
// SAVE SEGMENT
//==================================================

crossHappened = greenCross or redCross

if crossHappened
    seg = Segment.new(
        segStart,
        bar_index - 1,
        bar_index,
        currentHigh,
        currentHighBar,
        currentLow,
        currentLowBar,
        currentIsGreen
    )
    array.push(segments, seg)

    //--------------------------------------
    // Start next segment
    //--------------------------------------

    segStart := bar_index

    currentHigh := high
    currentHighBar := bar_index

    currentLow := low
    currentLowBar := bar_index

    currentIsGreen := greenCross

//==================================================
// DEBUG
//==================================================

if showDebug and crossHappened and HasEnoughSegments(3)

    Segment s0 = GetSegment(0)
    Segment s1 = GetSegment(1)
    Segment s2 = GetSegment(2)

    bool buyPattern = IsBuyPattern()
    bool sellPattern = IsSellPattern()

    //--------------------------------------------------
    // BUY DEBUG
    //--------------------------------------------------

    if greenCross

        float low1 = s2.lowest
        float high1 = s1.highest
        float low2 = s0.lowest

        float buyRetracement = GetBuyRetracement()

        string msg =
              "BUY Pattern Check"
          + "\nL1 : " + str.tostring(low1)
          + "\nH1 : " + str.tostring(high1)
          + "\nL2 : " + str.tostring(low2)
          + "\nRetracement : "
          + str.tostring(buyRetracement, "#.##") + "%"
          + "\nHigher Low : "
          + str.tostring(low2 > low1)
          + "\nResult : "
          + (buyPattern ? "PASS" : "FAIL")

        label.new(
            bar_index,
            low2,
            msg,
            style=label.style_label_up,
            color=buyPattern ? color.green : color.gray,
            textcolor=color.white
        )

    //--------------------------------------------------
    // SELL DEBUG
    //--------------------------------------------------

    if redCross

        float high1 = s2.highest
        float low1  = s1.lowest
        float high2 = s0.highest

        float sellRetracement = GetSellRetracement()

        string msg =
              "SELL Pattern Check"
          + "\nH1 : " + str.tostring(high1)
          + "\nL1 : " + str.tostring(low1)
          + "\nH2 : " + str.tostring(high2)
          + "\nRetracement : "
          + str.tostring(sellRetracement, "#.##") + "%"
          + "\nLower High : "
          + str.tostring(high2 < high1)
          + "\nResult : "
          + (sellPattern ? "PASS" : "FAIL")

        label.new(
            bar_index,
            high2,
            msg,
            style=label.style_label_down,
            color=sellPattern ? color.red : color.gray,
            textcolor=color.white
        )

//==================================================
// STRATEGY EXECUTION
//==================================================

if greenCross
    // Close existing SELL
    if strategy.position_size < 0
        strategy.close("SELL", comment="Green Cross")

    // Enter BUY when pattern is valid
    if IsBuyPattern() and strategy.position_size <= 0
        strategy.entry(
            "BUY",
            strategy.long,
            qty=fixedLot
        )

if redCross
    // Close existing BUY
    if strategy.position_size > 0
        strategy.close("BUY", comment="Red Cross")

    // Enter SELL when pattern is valid
    if IsSellPattern() and strategy.position_size >= 0
        strategy.entry(
            "SELL",
            strategy.short,
            qty=fixedLot
        )
