//@version=6
strategy(
    "TGK CDC Lookalike Account 2",
    overlay=true,
    pyramiding=0,
    initial_capital=100000,
    // process_orders_on_close=true,
    margin_long = 1,
    margin_short = 1,
    calc_on_every_tick = true,
    max_lines_count=500,
    max_labels_count=500
)

//==================================================
// INPUT
//==================================================

emaFastLen = input.int(12, "EMA Fast")
emaSlowLen = input.int(26, "EMA Slow")

showDebug = input.bool(true)

retracementMin = input.float(61.8, "Retracement Min %")
retracementMax = input.float(100.0, "Retracement Max %")

isFixedLot = input.bool(true, "Use Fixed Lot?")
fixedLot = input.float(10.0, "Fixed Lot", minval=0.01, step=0.01)

riskUSD = input.float(1000.0, "Risk Per Trade ($)", minval=0.01, step=100.0)
maxLot = input.float(100.0, "Max Lot", minval=0.01, step=0.01)
slBuffer = input.float(1.5, "SL Buffer ($)", minval=0.0, step=0.01)

setSlAtLastPivot = input.bool(false, "Set SL at last pivot?")

showPattern = input.bool(true, "Show Pattern")
showPatternLabels = input.bool(true, "Show Pattern Labels")

//==================================================
// EMA
//==================================================

ema12 = ta.ema(close, emaFastLen)
ema26 = ta.ema(close, emaSlowLen)

plot(ema12, color=color.green)
plot(ema26, color=color.orange)

//==================================================
// POSITION SIZE
//==================================================

// For XAUUSD, syminfo.pointvalue should be the value of a $1 move per lot.
// Check the symbol's contract specification before using this on another market.
CalcLot(float entryPrice, float stopPrice) =>
    float riskDistance = math.abs(entryPrice - stopPrice)
    float riskPerLot = riskDistance * syminfo.pointvalue
    float qty = riskPerLot > 0 ? riskUSD / riskPerLot : 0.0
    qty := math.max(qty, 0.01)
    qty := math.min(qty, maxLot)
    math.round(qty * 100) / 100
    qty

//==================================================
// PIVOTS
//==================================================

pivotLow = ta.pivotlow(low, 2, 1)
pivotHigh = ta.pivothigh(high, 2, 1)

var float lastPivotLow = na
var float lastPivotHigh = na

if not na(pivotLow)
    lastPivotLow := pivotLow

if not na(pivotHigh)
    lastPivotHigh := pivotHigh

//==================================================
// CROSS
//==================================================

greenCross = ta.crossover(ema12, ema26)
redCross   = ta.crossunder(ema12, ema26)

plotshape(greenCross,
     style=shape.circle,
     color=color.lime,
     size=size.small,
     location=location.belowbar)

plotshape(redCross,
     style=shape.circle,
     color=color.red,
     size=size.small,
     location=location.abovebar)

//==================================================
// CURRENT SEGMENT
//==================================================

var int segStart = na

var float currentHigh = na
var float currentLow  = na

var int currentHighBar = na
var int currentLowBar  = na

var bool currentIsGreen = ema12 > ema26

//==================================================
// SEGMENT DATA
//==================================================
type Segment
    int startBar
    int endBar

    int crossBar

    float highest
    int highestBar

    float lowest
    int lowestBar

    bool isGreen

var segments = array.new<Segment>()

//==================================================
// PATTERN DATA
//==================================================

type Pattern
    bool valid
    bool isBuy

    float point1
    float point2
    float point3

    int point1Bar
    int point2Bar
    int point3Bar

    float retracement

//==================================================
// SEGMENT FUNCTIONS
//==================================================

HasEnoughSegments(int count) =>
    array.size(segments) >= count

GetSegment(int offset) =>
    array.get(segments, array.size(segments) - 1 - offset)

//==================================================
// BUILD BUY PATTERN
//==================================================

BuildBuyPattern() =>
    Pattern result = Pattern.new(
        false,
        true,
        na,
        na,
        na,
        na,
        na,
        na,
        na
    )

    if not HasEnoughSegments(3)
        result
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        bool correctSequence = not s2.isGreen and s1.isGreen and not s0.isGreen

        if not correctSequence
            result
        else
            float low1  = s2.lowest
            float high1 = s1.highest
            float low2  = s0.lowest

            int low1Bar   = s2.lowestBar
            int high1Bar  = s1.highestBar
            int low2Bar   = s0.lowestBar

            bool higherLow = low2 > low1
            float L1H1Range = high1 - low1
            bool valid = false
            float retracement = L1H1Range > 0 ? (high1 - low2) / L1H1Range * 100.0 : na

            if higherLow
                valid := retracement >= retracementMin and retracement <= retracementMax

            Pattern.new(
                valid,
                true,
                low1,
                high1,
                low2,
                low1Bar,
                high1Bar,
                low2Bar,
                retracement
            )

//==================================================
// BUILD SELL PATTERN
//==================================================

BuildSellPattern() =>
    Pattern result = Pattern.new(
        false,
        false,
        na,
        na,
        na,
        na,
        na,
        na,
        na
    )

    if not HasEnoughSegments(3)
        result
    else
        Segment s0 = GetSegment(0)
        Segment s1 = GetSegment(1)
        Segment s2 = GetSegment(2)

        bool correctSequence = s2.isGreen and not s1.isGreen and s0.isGreen

        if not correctSequence
            result
        else
            float high1 = s2.highest
            float low1  = s1.lowest
            float high2 = s0.highest

            int high1Bar = s2.highestBar
            int low1Bar  = s1.lowestBar
            int high2Bar = s0.highestBar

            bool lowerHigh = high2 < high1
            float H1L1Range = high1 - low1
            bool valid = false
            float retracement = H1L1Range > 0 ? (high2 - low1) / H1L1Range * 100.0 : na

            if lowerHigh
                valid := retracement >= retracementMin and retracement <= retracementMax

            Pattern.new(
                valid,
                false,
                high1,
                low1,
                high2,
                high1Bar,
                low1Bar,
                high2Bar,
                retracement
            )

//==================================================
// DRAW BUY PATTERN
//==================================================

DrawBuyPattern(Pattern pattern) =>
    line.new(
        pattern.point1Bar,
        pattern.point1,
        pattern.point2Bar,
        pattern.point2,
        xloc=xloc.bar_index,
        color=color.green,
        width=2
    )

    line.new(
        pattern.point2Bar,
        pattern.point2,
        pattern.point3Bar,
        pattern.point3,
        xloc=xloc.bar_index,
        color=color.green,
        width=2
    )

//==================================================
// DRAW SELL PATTERN
//==================================================

DrawSellPattern(Pattern pattern) =>
    line.new(
        pattern.point1Bar,
        pattern.point1,
        pattern.point2Bar,
        pattern.point2,
        xloc=xloc.bar_index,
        color=color.red,
        width=2
    )

    line.new(
        pattern.point2Bar,
        pattern.point2,
        pattern.point3Bar,
        pattern.point3,
        xloc=xloc.bar_index,
        color=color.red,
        width=2
    )

//==================================================
// DRAW BUY LABEL
//==================================================

DrawBuyLabel(Pattern pattern) =>
    label.new(
        bar_index,
        pattern.point3,
        "BUY\nRetracement: "
          + str.tostring(pattern.retracement, "#.##") + "%",
        style=label.style_label_up,
        color=color.green,
        textcolor=color.white
    )

//==================================================
// DRAW SELL LABEL
//==================================================

DrawSellLabel(Pattern pattern) =>
    label.new(
        bar_index,
        pattern.point3,
        "SELL\nRetracement: "
          + str.tostring(pattern.retracement, "#.##") + "%",
        style=label.style_label_down,
        color=color.red,
        textcolor=color.white
    )

//==================================================
// INITIALIZE
//==================================================

if barstate.isfirst
    segStart := bar_index
    currentHigh := high
    currentLow := low
    currentHighBar := bar_index
    currentLowBar := bar_index
    currentIsGreen := ema12 > ema26

//==================================================
// UPDATE CURRENT SEGMENT
//==================================================

if high > currentHigh
    currentHigh := high
    currentHighBar := bar_index

if low < currentLow
    currentLow := low
    currentLowBar := bar_index

//==================================================
// SAVE SEGMENT
//==================================================

crossHappened = greenCross or redCross

if crossHappened
    seg = Segment.new(
        segStart,
        bar_index - 1,
        bar_index,
        currentHigh,
        currentHighBar,
        currentLow,
        currentLowBar,
        currentIsGreen
    )
    array.push(segments, seg)

    //--------------------------------------
    // Start next segment
    //--------------------------------------

    segStart := bar_index

    currentHigh := high
    currentHighBar := bar_index

    currentLow := low
    currentLowBar := bar_index

    currentIsGreen := greenCross

//==================================================
// DETECT CURRENT PATTERN
//==================================================

Pattern currentPattern = Pattern.new(
    false,
    true,
    na,
    na,
    na,
    na,
    na,
    na,
    na
)

if crossHappened
    if greenCross
        currentPattern := BuildBuyPattern()

    if redCross
        currentPattern := BuildSellPattern()

//==================================================
// DEBUG
//==================================================

if showDebug and crossHappened and HasEnoughSegments(3)
    if greenCross
        string msg =
              "BUY Pattern Check"
          + "\nL1 : " + str.tostring(currentPattern.point1)
          + "\nH1 : " + str.tostring(currentPattern.point2)
          + "\nL2 : " + str.tostring(currentPattern.point3)
          + "\nRetracement : "
          + str.tostring(currentPattern.retracement, "#.##") + "%"
          + "\nHigher Low : "
          + str.tostring(
                currentPattern.point3 > currentPattern.point1
            )
          + "\nResult : "
          + (currentPattern.valid ? "PASS" : "FAIL")

        label.new(
            bar_index,
            currentPattern.point3,
            msg,
            style=label.style_label_up,
            color=currentPattern.valid ? color.green : color.gray,
            textcolor=color.white
        )

    if redCross
        string msg =
              "SELL Pattern Check"
          + "\nH1 : " + str.tostring(currentPattern.point1)
          + "\nL1 : " + str.tostring(currentPattern.point2)
          + "\nH2 : " + str.tostring(currentPattern.point3)
          + "\nRetracement : "
          + str.tostring(currentPattern.retracement, "#.##") + "%"
          + "\nLower High : "
          + str.tostring(
                currentPattern.point3 < currentPattern.point1
            )
          + "\nResult : "
          + (currentPattern.valid ? "PASS" : "FAIL")

        label.new(
            bar_index,
            currentPattern.point3,
            msg,
            style=label.style_label_down,
            color=currentPattern.valid ? color.red : color.gray,
            textcolor=color.white
        )

//==================================================
// STRATEGY EXECUTION
//==================================================

if greenCross
    // Close existing SELL
    if strategy.position_size < 0
        strategy.close(
            "SELL",
            comment="Green Cross"
        )

    // =================================================
    // เข้าทุกแผน
    // ถ้า Pattern Valid ให้ใช้ SL ที่ Point 3 ของ Pattern
    // ถ้า Pattern Invalid ให้ใช้ SL ที่ Pivot Low ล่าสุด
    // =================================================
    float tradeSL = currentPattern.valid ? currentPattern.point3 - slBuffer : lastPivotLow - slBuffer
    // Risk sizing needs a confirmed pivot low below the long entry.
    bool validRiskSL = not na(tradeSL) and tradeSL < close
    float buyQty = validRiskSL ? CalcLot(close, tradeSL) : na

    if not na(buyQty)
        strategy.entry(
            "BUY",
            strategy.long,
            qty=buyQty
        )

        if setSlAtLastPivot and validRiskSL
            strategy.exit("BUY SL", "BUY", stop=tradeSL)

if redCross
    // Close existing BUY
    if strategy.position_size > 0
        strategy.close(
            "BUY",
            comment="Red Cross"
        )

    // =================================================
    // เข้าทุกแผน
    // ถ้า Pattern Valid ให้ใช้ SL ที่ Point 3 ของ Pattern
    // ถ้า Pattern Invalid ให้ใช้ SL ที่ Pivot High ล่าสุด
    // =================================================
    float tradeSL = currentPattern.valid ? currentPattern.point3 + slBuffer : lastPivotHigh + slBuffer
    // Risk sizing needs a confirmed pivot high above the short entry.
    bool validRiskSL = not na(tradeSL) and tradeSL > close
    float sellQty = validRiskSL ? CalcLot(close, tradeSL) : na

    if not na(sellQty)
        strategy.entry(
            "SELL",
            strategy.short,
            qty=sellQty
        )

        if setSlAtLastPivot and validRiskSL
            strategy.exit("SELL SL", "SELL", stop=tradeSL)

//==================================================
// PATTERN VISUALIZATION
//==================================================

if showPattern and currentPattern.valid
    if currentPattern.isBuy
        DrawBuyPattern(currentPattern)

        if showPatternLabels
            DrawBuyLabel(currentPattern)

    else
        DrawSellPattern(currentPattern)

        if showPatternLabels
            DrawSellLabel(currentPattern)
